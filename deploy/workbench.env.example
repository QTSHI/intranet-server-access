# Install as /etc/intranet-server-access/workbench.env.
# The HTTP listener and SSH relay target are restricted to loopback.
LAB_PREVIEW_PORT=8090
LAB_SSH_PORT=22002

# A single verified ED25519 public host key for the internal SSH server.
# Make the public key readable by the service's dynamic user; no private key here.
LAB_HOST_KEY_PATH=/etc/intranet-server-access/campus-host-key.pub

# Exact browser origins, separated by commas. No paths or trailing slashes.
LAB_ALLOWED_ORIGINS=https://lab.example.com
